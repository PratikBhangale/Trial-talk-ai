{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrialAgentTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-2:*:table/trial_agent"
    },
    {
      "Sid": "SesSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:us-east-2:*:identity/*",
        "arn:aws:ses:us-east-2:*:configuration-set/*"
      ]
    },
    {
      "Sid": "Claude",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-2:*:inference-profile/global.anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-4-6*",
        "arn:aws:bedrock:::foundation-model/anthropic.claude-sonnet-4-6*"
      ]
    }
  ]
}