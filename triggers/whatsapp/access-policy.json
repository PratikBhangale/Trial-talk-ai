{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PhoneLookup",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-2:461729033902:table/trial_agent"
    },
    {
      "Sid": "CallAgent",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": "arn:aws:bedrock-agentcore:us-east-2:461729033902:runtime/ContinuumAI_trial_agent-M50yJMBk8H*"
    },
    {
      "Sid": "SendWhatsApp",
      "Effect": "Allow",
      "Action": "social-messaging:SendWhatsAppMessage",
      "Resource": "arn:aws:social-messaging:us-east-2:461729033902:phone-number-id/*"
    }
  ]
}